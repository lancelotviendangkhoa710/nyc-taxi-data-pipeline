# =============================================================================
# NYC Taxi Data Engineering Project — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# AWS Credentials
# ---------------------------------------------------------------------------
# Option A — Static keys (local dev / CI).  Leave blank on EC2 with IAM role.
# When both are blank the pipeline falls back to the EC2 Instance Metadata
# Service (IMDS) automatically; do NOT set them to empty strings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region where S3 bucket and Redshift cluster live.
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# S3 (Data Lake / Staging)
# ---------------------------------------------------------------------------
S3_BUCKET=nyc-taxi-data-lake

# ---------------------------------------------------------------------------
# Amazon Redshift
# ---------------------------------------------------------------------------
REDSHIFT_HOST=redshift-cluster-1.xxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=your-redshift-password

# IAM role ARN that Redshift uses to read from S3 during COPY.
REDSHIFT_IAM_ROLE=arn:aws:iam::123456789012:role/RedshiftS3Access

# ---------------------------------------------------------------------------
# ETL pipeline settings
# ---------------------------------------------------------------------------
# Local staging retention after dbt tests succeed.
ETL_LOCAL_RETENTION_DAYS=7
# Optional manual row limit for smoke-testing. Do not set in production.
# ETL_TEST_ROW_LIMIT=1000

# ---------------------------------------------------------------------------
# Airflow — DockerOperator runtime
# ---------------------------------------------------------------------------
# Absolute host path to the project root (required by DockerOperator).
# Linux/EC2 example : NYC_TAXI_PROJECT_ROOT=/home/ec2-user/NYC_Taxi_Project
# Windows example   : NYC_TAXI_PROJECT_ROOT=D:/NYC_Taxi_Project
NYC_TAXI_PROJECT_ROOT=

# Set to "false" to disable all ETL writes (safety switch).
ENABLE_NYC_TAXI_ETL=true

# ---------------------------------------------------------------------------
# Failure alert — Gmail SMTP (optional but recommended for production)
# ---------------------------------------------------------------------------
# Email address that receives the alert when any DAG task fails.
ALERT_EMAIL_TO=your-email@gmail.com
# Gmail account used as the SMTP sender (can be same as ALERT_EMAIL_TO).
ALERT_SMTP_USER=your-sender@gmail.com
# Gmail App Password (NOT your Gmail login password).
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Gmail account.
ALERT_SMTP_PASSWORD=your-16-char-app-password

# ---------------------------------------------------------------------------
# EC2 (informational only — not read by the pipeline)
# ---------------------------------------------------------------------------
AWS_IPV4_PUBLIC_IP=your-public-ipv4-address
