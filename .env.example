# BigQuery runtime configuration. Keep this file safe to commit; never commit .env.
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_RAW=nyc_taxi_raw
# Host path for local Python. Docker Compose overrides this with /app/gcp_service_account.json.
GCP_KEYFILE_PATH=gcp_service_account.json

# Local staging retention after dbt tests succeed.
ETL_LOCAL_RETENTION_DAYS=7
# Optional manual test limit. Do not set for production batches.
# ETL_TEST_ROW_LIMIT=

# Airflow production DAG settings.
# Required by DockerOperator because the Docker daemon needs a host absolute path.
# Windows example: NYC_TAXI_PROJECT_ROOT=D:/NYC_Taxi_Project
NYC_TAXI_PROJECT_ROOT=
.
ENABLE_NYC_TAXI_ETL=true

# ---------------------------------------------------------------------------
# Failure alert — Gmail SMTP (optional but recommended for production)
# ---------------------------------------------------------------------------
# Email address that receives the alert when any DAG task fails.
ALERT_EMAIL_TO=your-email@gmail.com
# Gmail account used as the SMTP sender (can be same as ALERT_EMAIL_TO).
ALERT_SMTP_USER=your-sender@gmail.com
# Gmail App Password (NOT your Gmail login password).
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Gmail account.
ALERT_SMTP_PASSWORD=your-16-char-app-password
