# BigQuery runtime configuration. Keep this file safe to commit; never commit .env.
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_RAW=nyc_taxi_raw
# Host path for local Python. Docker Compose overrides this with /app/gcp_service_account.json.
GCP_KEYFILE_PATH=gcp_service_account.json

# Local staging retention after dbt tests succeed.
ETL_LOCAL_RETENTION_DAYS=7
# Optional manual test limit. Do not set for production batches.
# ETL_TEST_ROW_LIMIT=
