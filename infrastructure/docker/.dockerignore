# ============================================================================
# .dockerignore - Files bỏ qua khi build Docker image
# ============================================================================
# Giúp giảm kích thước image và tăng tốc độ build
# ============================================================================

# Git files
.git
.gitignore
.gitattributes

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/
*.log

# Data (nếu quá lớn)
# Tuy nhiên, nếu cần data trong container, đừng bỏ qua
# data/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# dbt specific
dbt/target/
dbt/logs/
dbt/packages/
dbt/dbt_packages/

# Temporary files
*.tmp
*.bak
*.swp
.env.local
