# ============================================================================
# Dockerfile cho Spark ETL - NYC Taxi Project

FROM python:3.12-slim-bookworm

# Cập nhật packages và cài Java (Spark cần Java)
# apt-get clean + rm giúp giảm kích thước image
RUN apt-get update && \
    apt-get install -y openjdk-17-jdk-headless curl wget procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV SPARK_HOME=/usr/local/lib/python3.12/site-packages/pyspark
ENV PATH=$PATH:$JAVA_HOME/bin:$SPARK_HOME/bin
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY pyproject.toml /tmp/pyproject.toml
RUN pip install --no-cache-dir "pyspark==3.5.0" python-dotenv google-cloud-bigquery pyarrow && rm /tmp/pyproject.toml


# Set working directory
WORKDIR /app

# Copy source code (read-only để bảo vệ)
COPY spark/ /app/spark/
COPY .env /app/.env

# Copy entrypoint script
COPY infrastructure/docker/entrypoint-spark.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Chạy entrypoint script khi container start
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Health check: Kiểm tra Spark có hoạt động không
# Chạy mỗi 30 giây, timeout 10 giây, retry 3 lần
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import pyspark; print('OK')" || exit 1
